# Copy this file to .env and fill in the values. .env is git-ignored.

# --- Supabase (required for sign-in and saved trips) ---------------------------
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Gemini (optional) ----------------------------------------------------
# Without a key, every AI feature returns realistic sample data.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Payments (Plus plan) ----------------------------------------------------------
# Supabase → Project Settings → API → service_role. SERVER ONLY — never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# PayMongo → Developers → API Keys (use sk_test_… while testing).
# Without it, development uses a built-in test checkout instead.
PAYMONGO_SECRET_KEY=
# PayMongo → Developers → Webhooks → signing secret (whsk_…), for production.
PAYMONGO_WEBHOOK_SECRET=
# PAYMONGO_METHODS=gcash,paymaya,card
# Public URL used in payment redirects (defaults to the request host).
# APP_URL=https://your-domain.com

# --- Affiliate partners (commission links) ---------------------------------------
# IDs are public (they appear in links), so these use the VITE_ prefix.
VITE_BOOKING_AID=
VITE_AGODA_CID=
VITE_KLOOK_AID=
# Optional: replace a link format with the one from the partner's deep-link tool.
# Placeholders: {query} {from} {to} {id} {url} (url = the default link, encoded).
# VITE_AGODA_LINK=
# VITE_KLOOK_LINK=
# VITE_CEBUPACIFIC_LINK=https://<affiliate-network>/deeplink?url={url}
# VITE_AIRASIA_LINK=https://<affiliate-network>/deeplink?url={url}

# --- Server -----------------------------------------------------------------------
# PORT=5000
